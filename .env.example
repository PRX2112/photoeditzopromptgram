# ==============================================================================
# PhotoEditZoPromptGram - Environment Configuration
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
# Get your connection string from the Neon console (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-cool-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Temporary Storage (Required for Instagram Publishing & Cleanup)
# Generated from the Vercel Dashboard -> Storage -> Blob Store
# Required permissions: Read and Write token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# Administrator Authentication
ADMIN_EMAIL="admin@photographerprompthub.com"
ADMIN_PASSWORD="PhotographerPromptAdmin2026!"
AUTH_SECRET="your-32-byte-hex-jwt-auth-secret"

# Token Encryption (AES-256-GCM 32-byte hex key for encrypting Instagram access tokens at rest)
TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# Public App Base URL (Used for generating prompt links sent in Instagram private replies)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API (Get from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"

# Meta Instagram Graph API & Webhooks (Get from Meta for Developers: https://developers.facebook.com)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="your-random-verification-token"
# Optional direct testing account configuration (Graph API Explorer / Access Token Debugger)
# META_INSTAGRAM_ACCOUNT_ID="17841479958291582"
# META_INSTAGRAM_ACCESS_TOKEN="your-user-or-page-access-token"

# Scheduled Background Queue Security (Used by Vercel Cron or external schedulers)
CRON_SECRET="your-random-cron-secret"

# Ephemeral Image Storage Strategy (options: "vercel-blob" | "ephemeral-serverless")
STORAGE_PROVIDER="vercel-blob"
