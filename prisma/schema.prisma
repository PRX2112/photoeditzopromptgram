// Photographer Prompt Hub - Prisma Schema
// Optimized for Neon PostgreSQL with connection pooling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ImageLifecycleStatus {
  UPLOADED
  READY_TO_PUBLISH
  PUBLISHING
  PUBLISHED
  CLEANUP_PENDING
  DELETED
  CLEANUP_FAILED
}

enum JobType {
  PUBLISH_POST
  RECONCILE_PUBLICATION
  CLEANUP_BLOB
  DELIVER_INSTAGRAM_DM
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DMReservationStatus {
  RESERVED
  SENDING
  SENT
  FAILED
  UNKNOWN
  SUPPRESSED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  role         Role               @default(ADMIN)
  accounts     InstagramAccount[]
  activityLogs ActivityLog[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([email])
}

model InstagramAccount {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId             String              @unique
  username             String
  name                 String?
  profilePictureUrl    String?
  accessTokenEncrypted String              // AES-256-GCM encrypted token
  tokenExpiresAt       DateTime?
  isConnected          Boolean             @default(true)
  permissions          String?             // Comma-separated or JSON list of granted scopes
  posts                Post[]
  automationSettings   AutomationSetting[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([igUserId])
  @@index([userId])
}

model Prompt {
  id                 String               @id @default(cuid())
  title              String
  originalPrompt     String               @db.Text
  category           String               @default("Uncategorized")
  tags               String               @default("") // Comma-separated tags or JSON string
  generationSettings String?              @db.Text // JSON string: Aspect ratio, camera, lighting, engine, etc.
  slug               String               @unique
  isArchived         Boolean              @default(false)
  viewCount          Int                  @default(0)
  copyCount          Int                  @default(0)

  // Source Image Storage Lifecycle (Vercel Blob)
  sourceImageUrl        String?              @db.Text
  sourceBlobPathname    String?
  sourceContentType     String?
  sourceImageSize       Int?
  sourceImageStatus     ImageLifecycleStatus @default(UPLOADED)
  sourceImageUploadedAt DateTime?            @default(now())
  sourceImageDeletedAt  DateTime?

  // Prompt Publication & Availability State
  isPublished        Boolean              @default(false)
  publishedAt        DateTime?

  // Optional Camera & Technical Metadata (All Optional)
  cameraModel        String?
  lens               String?
  focalLength        String?
  aperture           String?
  shutterSpeed       String?
  iso                String?
  lightingSetup      String?
  renderingEngine    String?

  posts              Post[]
  promptRequests     PromptRequest[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isArchived])
  @@index([isPublished])
  @@index([createdAt])
}

model Post {
  id                     String               @id @default(cuid())
  promptId               String
  prompt                 Prompt               @relation(fields: [promptId], references: [id], onDelete: Cascade)
  instagramAccountId     String?
  instagramAccount       InstagramAccount?    @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  caption                String               @db.Text
  hashtags               String               @db.Text // Comma or space separated hashtags
  commentKeyword         String               // Configured keyword to trigger prompt delivery (e.g. BRIDAL)
  mediaType              String               @default("IMAGE") // IMAGE, CAROUSEL, REELS

  // Vercel Blob & Image Lifecycle Tracking (Source & Rendered Assets)
  blobUrl                String?              @db.Text // Temporary Vercel Blob URL (published image)
  blobPathname           String?              // Storage key / pathname in Vercel Blob
  temporaryImageUrl      String?              @db.Text // Backward-compatible ephemeral storage URL
  temporaryAssetKey      String?              // Legacy reference key
  imageUploadedAt        DateTime?            @default(now())
  imageLifecycleStatus   ImageLifecycleStatus @default(UPLOADED)
  imageDeletedAt         DateTime?
  cleanupAttempts        Int                  @default(0)
  lastCleanupError       String?              @db.Text

  // Finished Instagram Rendered Image (Created via FFmpeg)
  renderedImageUrl       String?              @db.Text // Vercel Blob URL for 1080x1350 rendered image
  renderedBlobPathname   String?
  renderedImageStatus    ImageLifecycleStatus? @default(UPLOADED)
  renderedAt             DateTime?
  sourceBlobDeletedAt    DateTime?
  renderedBlobDeletedAt  DateTime?

  // Meta Instagram Publishing & Reconciliation
  containerId            String?              // Instagram media container ID
  instagramMediaId       String?              @unique // Confirmed Instagram Media ID
  instagramPermalink     String?              @db.Text
  status                 PostStatus           @default(DRAFT)
  scheduledFor           DateTime?
  publishedAt            DateTime?            // Confirmed publication timestamp
  publicationAttempts    Int                  @default(0)
  lastPublishError       String?              @db.Text
  reconciliationMetadata String?              @db.Text // JSON containing retry/reconciliation details
  errorMessage           String?              @db.Text
  retryCount             Int                  @default(0)

  promptRequests         PromptRequest[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([promptId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([imageLifecycleStatus])
  @@index([scheduledFor])
  @@index([instagramMediaId])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  jobType     JobType
  payload     String    @db.Text // JSON string containing job parameters
  status      JobStatus @default(PENDING)
  runAt       DateTime
  lockedAt    DateTime?
  lockedBy    String?   // Worker instance identifier
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique // Meta webhook event ID or hash for idempotency
  eventType   String    // comments, mentions, etc.
  commentId   String?   @unique // Unique constraint on comment ID to deduplicate incoming webhook events
  rawPayload  String    @db.Text
  signature   String?
  isProcessed Boolean   @default(false)
  processedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([commentId])
  @@index([isProcessed])
}

model PromptRequest {
  id                    String              @id @default(cuid())
  postId                String
  post                  Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  instagramAccountId    String?
  instagramScopedUserId String              // Stable Instagram-scoped commenter ID (IGSID)
  firstCommentId        String              // First qualifying comment ID
  firstCommentTimestamp DateTime?
  deliveryStatus        DMReservationStatus @default(RESERVED)
  reservedAt            DateTime            @default(now())
  sendingAt             DateTime?
  sentAt                DateTime?
  metaMessageId         String?             // Meta message ID returned upon successful private reply
  attemptCount          Int                 @default(0)
  lastError             String?             @db.Text

  matchedPromptId       String?
  matchedPrompt         Prompt?             @relation(fields: [matchedPromptId], references: [id], onDelete: SetNull)
  commentText           String?             @db.Text

  // Backward compatibility fields
  incomingCommentId     String?             // Alias to firstCommentId
  instagramMediaId      String?
  deliveryMethod        String              @default("PRIVATE_REPLY")
  privateReplyId        String?             // Alias to metaMessageId
  retryCount            Int                 @default(0)
  errorMessage          String?             @db.Text
  deliveredAt           DateTime?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // STRICT IDEMPOTENCY: Exactly one automated reply reservation per user per post!
  @@unique([postId, instagramScopedUserId])
  @@index([instagramScopedUserId])
  @@index([deliveryStatus])
  @@index([postId])
  @@index([createdAt])
}

model AutomationSetting {
  id                     String            @id @default(cuid())
  instagramAccountId     String?           @unique
  instagramAccount       InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  isAutomationEnabled    Boolean           @default(true)
  globalKeyword          String            @default("PROMPT")
  replyTemplate          String            @default("Here is the photography prompt you requested: {prompt_url}")
  maxRepliesPerCommenter Int               @default(1)
  retentionHours         Int               @default(24) // Hours before temporary assets are deleted
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String   // POST_PUBLISHED, PROMPT_CREATED, PRIVATE_REPLY_SENT, etc.
  entityType String   // Post, Prompt, PromptRequest, InstagramAccount
  entityId   String?
  details    String?  @db.Text // JSON metadata
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
